# Runtime environment for the Cloud Run service. Plain values go in --set-env-vars; the four
# secrets go in Secret Manager (see README.md) and are mounted with --set-secrets.

# --- secrets (Secret Manager) ---
# CUEFLOW_SECRET_KEY=            # must equal the key of any database you restore from
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# CUEFLOW_ADMIN_TOKEN=
# CUEFLOW_MCP_TOKEN=

# --- plain env vars ---
CUEFLOW_PUBLIC_URL=https://cueflow.example.com
CUEFLOW_DB_MAX_CONNS=5
CUEFLOW_AGENT_CONCURRENCY=3

CUEFLOW_QUEUE=cloudtasks
CUEFLOW_TICK=external
CUEFLOW_MEDIA_STORAGE=gcs://my-cueflow-media/media
CUEFLOW_TASKS_QUEUE=projects/my-project/locations/asia-northeast1/queues/cueflow-work
# The Cloud Run URL (https://cueflow-xxxx-an.a.run.app), not the Cloudflare hostname, unless
# Cloudflare Access lets /internal/* through.
CUEFLOW_TASKS_TARGET_URL=https://cueflow-xxxxxxxx-an.a.run.app
CUEFLOW_TASKS_SERVICE_ACCOUNT=cueflow-tasks@my-project.iam.gserviceaccount.com
# Both identities that call /internal/*: the Cloud Tasks signer and the Cloud Scheduler signer.
CUEFLOW_INTERNAL_SERVICE_ACCOUNTS=cueflow-tasks@my-project.iam.gserviceaccount.com,cueflow-scheduler@my-project.iam.gserviceaccount.com
