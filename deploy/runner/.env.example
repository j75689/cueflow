# Copy to .env (git ignores it) and keep it readable by you only: chmod 600 .env

# Claude Code login for the agent. On the host run `claude setup-token` and paste the token.
# (The host's own login is not visible in the container; on macOS it lives in the Keychain.)
CLAUDE_CODE_OAUTH_TOKEN=

# A fine-grained personal access token for the repos the agent may work on, and nothing else:
# Contents + Pull requests read/write, Metadata read. No Workflows, no Administration.
GH_TOKEN=

# The identity on the agent's commits.
GIT_NAME=CueFlow agent
GIT_EMAIL=
