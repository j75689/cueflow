# Copy to .env and fill in. Never commit .env.

# --- CueFlow ---
# Image: slim (default) | agents (external agents: Claude Code, Codex)
CUEFLOW_IMAGE_TARGET=slim
# 32-byte key that encrypts connector credentials (AES-256-GCM). Generate: openssl rand -base64 32
# Back it up (e.g. in a password manager): losing it makes stored API keys/passwords unreadable.
# To change it without re-entering credentials, see "Rotating the secret key" in the README.
CUEFLOW_SECRET_KEY=
# Old key(s) still accepted for reading during a rotation (comma-separated). Empty otherwise.
CUEFLOW_SECRET_KEY_PREVIOUS=
# Optional bearer token for the dashboard/API. Recommended if anyone else can reach localhost:3000.
CUEFLOW_ADMIN_TOKEN=
CUEFLOW_DB_PASSWORD=cueflow
# Base URL used in review-reminder emails.
CUEFLOW_PUBLIC_URL=http://localhost:3000
# Optional: send a "drafts awaiting review" digest via every active email notifier, e.g. "0 9 * * *".
CUEFLOW_DIGEST_CRON=
# Optional server-wide LLM credentials, used by connectors whose own credential fields are blank.
# Credentials entered in the UI are stored encrypted per connector and take precedence.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# Name of an `ant auth login` profile (mount ~/.config/anthropic, see docker-compose.yml)
ANTHROPIC_PROFILE=
# Claude on Amazon Bedrock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_BEARER_TOKEN_BEDROCK=
# Claude/Gemini on Google Vertex AI (path inside the container to a mounted service account key;
# leave blank when mounting ~/.config/gcloud from `gcloud auth application-default login`)
GOOGLE_APPLICATION_CREDENTIALS=
TZ=Asia/Taipei

# --- Postiz ---
POSTIZ_URL=http://localhost:4007
# Any long random string: openssl rand -hex 32
POSTIZ_JWT_SECRET=
POSTIZ_DB_PASSWORD=postiz
POSTIZ_DISABLE_REGISTRATION=false
TEMPORAL_DB_PASSWORD=temporal

# Platform developer apps used by Postiz to connect channels (see Postiz docs per provider).
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
